<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS 定时任务：每天 09:00 自动跑 run.py all。
  1) 把下面 /Users/你 改成你的真实路径（含 venv 与仓库位置）
  2) cp 到 ~/Library/LaunchAgents/ 后：launchctl load ~/Library/LaunchAgents/com.yihua.archive.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yihua.archive</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/你/yihua-monitor/archive/.venv/bin/python</string>
    <string>/Users/你/yihua-monitor/archive/run.py</string>
    <string>all</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/你/yihua-monitor/archive</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>OPENAI_API_KEY</key>
    <string>在这里填或改用 keychain</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/yihua-archive.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/yihua-archive.err</string>
</dict>
</plist>
